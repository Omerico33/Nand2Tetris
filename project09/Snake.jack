/**	The mythological Snake game.
	Perhaps not really identified with the classic Tetris games,
	but many of the Nokia phone users during the 2000's would
	agree that this mildly annoying little game gave them at
	least some time of distraction.
	During my school days I've had plenty of better choices for
	games, but still on occasions when nothing else was available
	I found myself playing this challenging game and I've
	actually got better. Now it's time to relive some childhood
	memories and code a Snake game.
	The most notable thing about this game is the progressive
	speed. The more fruits you eat, the faster you get (which is
	actually bad for you since faster means harder in this game).
	The game board is comprised of a 32x64 grid of cells, which,
	in accordance to our screen dimensions in pixels, take a space
	of 8x8 pixels each.
	The snake length at the start is 2.
	Since there is no random function at our disposal and I wanted
	to randomize the fruit location on the grid, I've decided to
	implement a pseudo-randomizer which starts with 1, and each
	time multiply by 3 modulo 64. Since the order of 3 modulo 64
	is 16, this gives us 16 numbers with no discernible pattern. */
class Snake {
	field Grid game_board; // 32x64 Cells grid.
	field int head_row, head_column, tail_row, tail_column; // The locations of the snake's head and tail accordingly.
	field int randomizer; // We store here a (pseudo) random number in the range of 0-63.
	field int length; // The length of the snake. Start with 2.
	
	/* Some constants - EMPTY, SNAKE, FRUIT are for the content of the Cells
						LEFT, UP, RIGHT, DOWN are for the direction of Cells. */
	static int EMPTY, SNAKE, FRUIT, LEFT, UP, RIGHT, DOWN;
	
	constructor Snake new() {
		var int i, j;
		var Cell cur_cell;
		
		let EMPTY = 0;
		let SNAKE = 1;
		let FRUIT = 2;
		let LEFT = 130;
		let UP = 131;
		let RIGHT = 132;
		let DOWN = 133;
		
		/* 	The snake starts at (19-20, 24) with direction UP.
			The fruit at the start is at (1,3). */
		let game_board = Grid.new(32, 64);
		let randomizer = 3;
		let cur_cell = game_board.get(20, 24);
		do cur_cell.setContent(SNAKE);
		do drawCell(20, 24, true);
		do cur_cell.setDirection(UP);
		let cur_cell = game_board.get(19, 24);
		do cur_cell.setContent(SNAKE);
		do drawCell(19, 24, true);
		do cur_cell.setDirection(UP);
		let cur_cell = game_board.get(1, 3);
		do cur_cell.setContent(FRUIT);
		do drawCell(1, 3, true);
		let head_row = 19;
		let head_column = 24;
		let tail_row = 20;
		let tail_column = 24;
		let length = 2;
		
		return this;
	}
	
	/* Gets the length of the snake for calculating the idle time in the main function. */
	method int getLength() {
		return length;
	}
	
	/* Gets the next random number and store it in the randomize field. */
	method void randomizerUpdate() {
		var int temp;
		
		let randomizer = 3 * randomizer;
		let temp = randomizer / 64;
		let randomizer = randomizer - (temp * 64);
		
		return;
	}
	
	/* Draw the cell at location (row, column) on the Screen with color val (black if val=true, white otherwise). */
	method void drawCell(int row, int column, boolean val) {
		var int x, y, z, w;
		
		let x = column * 8;
		let y = row * 8;
		let z = (column + 1) * 8 - 1;
		let w = (row + 1) * 8 - 1;
		do Screen.setColor(val);
		do Screen.drawRectangle(x, y, z, w);
		
		return;
	}
	
	/* Update the game according to the key, which is a Keyboard direction. */
	method boolean update(int key) {
		var int i, j, head_direction;
		var boolean fruit_eaten, reached_tail;
		var Cell cur, up, down, left, right;
		
		let cur = game_board.get(head_row, head_column);
		
		if ((((cur.getDirection() = UP) | (cur.getDirection() = DOWN)) & 
			((key = LEFT) | (key = RIGHT))) |
			(((cur.getDirection() = LEFT) | (cur.getDirection() = RIGHT)) &
			((key = UP) | (key = DOWN)))) { // Update key i.f.f. key is perpendicular to the current direction of the snake's head.
			do cur.setDirection(key);
		}
		if (cur.getDirection() = DOWN) {
			if (head_row = 31) { // Game is over when snake's head reached beyond the bottom row.
				return false;
			}
			else {
				let down = game_board.get(head_row+1, head_column);
				if (down.getContent() = SNAKE) { // Game is over when snake's head collides its body.
					return false;
				}
				let fruit_eaten = (down.getContent() = FRUIT); // Condition for the fruit to be eaten.
			}
		}
		if (cur.getDirection() = UP) {
			if (head_row = 0) { // Game is over when snake's head reached beyond the top row.
				return false;
			}
			else {
				let up = game_board.get(head_row-1, head_column);
				if (up.getContent() = SNAKE) { // Game is over when snake's head collides its body.
					return false;
				}
				let fruit_eaten = (up.getContent() = FRUIT); // Condition for the fruit to be eaten.
			}
		}
		if (cur.getDirection() = LEFT) {
			if (head_column = 0) { // Game is over when snake's head reached beyond the left column.
				return false;
			}
			else {
				let left = game_board.get(head_row, head_column-1);
				if (left.getContent() = SNAKE) { // Game is over when snake's head collides its body.
					return false;
				}
				let fruit_eaten = (left.getContent() = FRUIT); // Condition for the fruit to be eaten.
			}
		}
		if (cur.getDirection() = RIGHT) {
			if (head_column = 63) { // Game is over when snake's head reached beyond the right column.
				return false;
			}
			else {
				let right = game_board.get(head_row, head_column+1);
				if (right.getContent() = SNAKE) { // Game is over when snake's head collides its body.
					return false;
				}
				let fruit_eaten = (right.getContent() = FRUIT); // Condition for the fruit to be eaten.
			}
		}
		let i = head_row;
		let j = head_column;
		let head_direction = cur.getDirection();
		/* Updates the next location of the snake's head. */
		if (cur.getDirection() = UP) {
			let head_row = head_row - 1;
		}
		else {
			if (cur.getDirection() = DOWN) {
				let head_row = head_row + 1;
			}
				else {
					if (cur.getDirection() = LEFT) {
						let head_column = head_column - 1;
					}
						else {
							let head_column = head_column + 1;
						}
				}
		}
		let cur = game_board.get(head_row, head_column);
		do cur.setContent(SNAKE); // Update the content of the new head.
		do cur.setDirection(head_direction); // Update the direction of the new head to be the same as the direction of the previous head.
		do drawCell(head_row, head_column, true); // Update the new head on the Screen.
		if (fruit_eaten) { // If the fruit was eaten we need to generate another fruit on the screen.
			let length = length + 1; // If the fruit was eaten the snake's length had increased.
			do randomizerUpdate();
			let i = randomizer;
			/* 	The randomizer gives values in the range 0-63, but for the row index we want value in
				the range of 0-31, so if the value is greater than 31 we subtract 32 and the result is
				necessarily in the range of 0-31. */
			if (i > 31) {
				let i = i - 32;
			}
			do randomizerUpdate();
			let j = randomizer;
			let cur = game_board.get(i, j);
			while (cur.getContent() = SNAKE) { // Keep generating Cell indices until we reach an EMPTY Cell.
				do randomizerUpdate();
				let i = randomizer;
				if (i > 31) {
					let i = i - 32;
				}
				do randomizerUpdate();
				let j = randomizer;
				let cur = game_board.get(i, j);
			}
			do cur.setContent(FRUIT); // Update the new Cell to contain the FRUIT.
			do drawCell(i, j, true); // Update the fruit Cell on the Screen.
		}
		else { // If the fruit was not eaten we should set the Cell of the previous snake's tail to be EMPTY.
			let cur = game_board.get(tail_row, tail_column);
			do cur.setContent(EMPTY); // Set the previous snake's tail Cell's content to be EMPTY.
			do drawCell(tail_row, tail_column, false); // Update that this Cell is empty  on the Screen.
			/* Updates the next location of the snake's tail. */
			if (cur.getDirection() = DOWN) {
				let tail_row = tail_row + 1;
			}
			else {
				if (cur.getDirection() = UP) {
					let tail_row = tail_row - 1;
				}
				else {
					if (cur.getDirection() = LEFT) {
						let tail_column = tail_column - 1;
					}
					else {
						let tail_column = tail_column + 1;
					}
				}
			}
		}
		
		return true;
	}
	
	/*	This function is invoked when the game is over.
		Paints the Screen black. */
	method void gameOver() {
		var int i, j;
		
		let i = 0;
		while (i < 32) {
			let j = 0;
			while (j < 64) {
				do drawCell(i, j, true);
				let j = j + 1;
			}
			let i = i + 1;
		}
		
		return;
	}
}
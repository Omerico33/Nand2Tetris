/**
 * A library for handling user input from the keyboard.
 */
class Keyboard {
	static int char_counter;

    /** Initializes the keyboard. */
    function void init() {
		let char_counter = -1;
		return;
    } 

    /**
     * Returns the character of the currently pressed key on the keyboard;
     * if no key is currently pressed, returns 0.
     *
     * Recognizes all ASCII characters, as well as the following keys:
     * new line = 128 = String.newline()
     * backspace = 129 = String.backspace()
     * left arrow = 130
     * up arrow = 131
     * right arrow = 132
     * down arrow = 133
     * home = 134
     * End = 135
     * page up = 136
     * page down = 137
     * insert = 138
     * delete = 139
     * ESC = 140
     * F1 - F12 = 141 - 152
     */
    function char keyPressed() {
		return Memory.peek(24576);
    }

    /**	Waits until a key is pressed on the keyboard and released,
     *  then echoes the key to the screen, and returns the character 
     *  of the pressed key. */
    function char readChar() {
		var char pressed_key;

		let pressed_key = Keyboard.keyPressed();
		while (pressed_key = 0) {
			let pressed_key = Keyboard.keyPressed();
		}
		while (~(Keyboard.keyPressed() = 0)) {}
		if (~(char_counter = -1)) {
			if (pressed_key = 129) {
				if (char_counter > 0) {
					let char_counter = char_counter - 1;
					do Output.printChar(pressed_key);
				}
			}
			else {
				let char_counter = char_counter + 1;
				do Output.printChar(pressed_key);
			}
		}
		else {
			do Output.printChar(pressed_key);
		}
		return pressed_key;
    }

    /**	Displays the message on the screen, reads from the keyboard the entered
     *  text until a newline character is detected, echoes the text to the screen,
     *  and returns its value. Also handles user backspaces. */
    function String readLine(String message) {
		var String text, new_text;
		var int max_length, i;
		var char pressed_key;
		
		let char_counter = 0;
		do Output.printString(message);
		let max_length = 1;
		let text = String.new(max_length);
		let pressed_key = Keyboard.readChar();
		while (~(pressed_key = 128)) {
			if (pressed_key = 129) {
				if (text.length() > 0) {
					do text.eraseLastChar();
				}
			}
			else {
				if (text.length() = max_length) {
					let max_length = max_length + max_length;
					let new_text = String.new(max_length);
					let i = 0;
					while (i < text.length()) {
						let new_text = new_text.appendChar(text.charAt(i));
						let i = i + 1;
					}
					do text.dispose();
					let text = new_text;
				}
				let text = text.appendChar(pressed_key);
			}
			let pressed_key = Keyboard.readChar();
		}
		let char_counter = -1;
		return text;
    }   

    /** Displays the message on the screen, reads from the keyboard the entered
     *  text until a newline character is detected, echoes the text to the screen,
     *  and returns its integer value (until the first non-digit character in the
     *  entered text is detected). Also handles user backspaces. */
    function int readInt(String message) {
		var String text;
		
		let text = Keyboard.readLine(message);
		return text.intValue();
    }
}

// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Register(in=outtplus1, load=true, out=outt);
    Register(in=in, load=true, out=int);
    Bit(in=reset, load=true, out=preset);
    Bit(in=load, load=true, out=pload);
    Bit(in=inc, load=true, out=pinc);
    Inc16(in=outt, out=outtinc);
    Mux16(a=outt, b=outtinc, sel=pinc, out=outtstep1);
    Mux16(a=outtstep1, b=int, sel=pload, out=outtstep2);
    Mux16(a=outtstep2, b=false, sel=preset, out=outtplus1);
    Mux16(a=outtstep2, b=false, sel=preset, out=out);
}
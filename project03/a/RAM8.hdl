// File name: projects/3/a/RAM8.hdl
/**
 * Memory of eight 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:
    DMux8Way(in=load, sel=address, a=a, b=b, c=c, d=d, e=e, f=f, g=g, h=h);
    Register(in=in, load=a, out=reg000);
    Register(in=in, load=b, out=reg001);
    Register(in=in, load=c, out=reg010);
    Register(in=in, load=d, out=reg011);
    Register(in=in, load=e, out=reg100);
    Register(in=in, load=f, out=reg101);
    Register(in=in, load=g, out=reg110);
    Register(in=in, load=h, out=reg111);
    Mux8Way16(a=reg000, b=reg001, c=reg010, d=reg011, e=reg100, f=reg101, g=reg110, h=reg111, sel=address, out=out);
}
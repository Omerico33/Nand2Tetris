// File name: projects/05/Memory.hdl

/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O. 
 * The chip facilitates read and write operations, as follows:
 *     Read:  out(t) = Memory[address(t)](t)
 *     Write: if load(t-1) then Memory[address(t-1)](t) = in(t-1)
 * In words: the chip always outputs the value stored at the memory 
 * location specified by address. If load==1, the in value is loaded 
 * into the memory location specified by address. This value becomes 
 * available through the out output from the next time step onward.
 * Address space rules:
 * Only the upper 16K+8K+1 words of the Memory chip are used. 
 * Access to address>0x6000 is invalid. Access to any address in 
 * the range 0x4000-0x5FFF results in accessing the screen memory 
 * map. Access to address 0x6000 results in accessing the keyboard 
 * memory map. The behavior in these addresses is described in the 
 * Screen and Keyboard chip specifications given in the book.
 */
 
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=ram16ktoggle);
    Not(in=address[13], out=notadd13);
    Not(in=address[12], out=notadd12);
    And(a=notadd13, b=address[14], out=screentoggle);
    Or8Way(in=address[0..7], out=oradd0to7);
    Not(in=oradd0to7, out=notoradd0to7);
    Or8Way(in=address[5..12], out=oradd5to12);
    Not(in=oradd5to12, out=notoradd5to12);
    And(a=notoradd0to7, b=notoradd5to12, out=allzero0to12);
    And(a=address[13], b=address[14], out=allone13to14);
    And(a=allzero0to12, b=allone13to14, out=keyboardtoggle);

    And(a=load, b=ram16ktoggle, out=ram16kload);
    And(a=load, b=screentoggle, out=screenload);
    And(a=load, b=keyboardtoggle, out=keyboardload);

    RAM16K(in=in, load=ram16kload, address=address[0..13], out=ram16kout);
    Screen(in=in, address=address[0..12], load=screenload, out=screenout);
    Keyboard(out=keyboardout);

    Mux16(a=screenout, b=ram16kout, sel=ram16ktoggle, out=ram16korscreen);
    Mux16(a=keyboardout, b=ram16kout, sel=ram16ktoggle, out=ram16korkeyboard);
    Mux16(a=ram16korkeyboard, b=ram16korscreen, sel=screentoggle, out=finalout);

    Or(a=ram16ktoggle, b=screentoggle, out=validadd1);
    Or(a=validadd1, b=keyboardtoggle, out=validadd);

    Mux16(a=false, b=finalout, sel=validadd, out=out);
}